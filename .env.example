# BIG Capital — environment configuration

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase free tier is fine)
# Example: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=

# EODHD API token — sign up at https://eodhd.com
# Use `demo` initially for testing (covers AAPL.US, TSLA.US, AMZN.US, MCD.US,
# BTC-USD.CC, EURUSD.FOREX with no daily limit).
# Email support@eodhistoricaldata.com to apply the 50% academic discount.
EODHD_API_TOKEN=demo

# Secret for protecting Vercel cron endpoints
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Clerk auth — sign up at clerk.com, create an application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sentry monitoring (optional)
SENTRY_DSN=
